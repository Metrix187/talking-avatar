# Copy to .env and fill in ONE of these. The server picks whichever is set.
# Meta Model API (Muse Spark) - https://dev.meta.ai
MODEL_API_KEY=
# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Optional
# AVATAR_LLM=meta|anthropic        force a provider when both keys are set
# AVATAR_LLM_MODEL=muse-spark-1.3  model id for the chosen provider
# AVATAR_VOICE=af_heart            default Kokoro voice
# AVATAR_STT_MODEL=small.en        better hearing, about a second slower
# AVATAR_COMPILE=1                 torch.compile the models (same as run.py --compile); needs triton-windows
# AVATAR_STEPS=4                   more denoise steps; real time on this laptop only with AVATAR_COMPILE=1
# AVATAR_KEEP_GPU_HOT=0            stop holding the GPU clock up between chunks
